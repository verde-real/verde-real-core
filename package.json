{
  "name": "verde-real-core",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos, constantes e regras de negócio compartilhadas entre o app e o site Verde Real",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,iife --global-name VerdeRealCore --dts",
    "dev": "tsup src/index.ts --format cjs,esm,iife --global-name VerdeRealCore --dts --watch"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}